<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>chatgpt-msix</id>
    <version>26.825.6671.4</version>
    <title>ChatGPT Desktop</title>
    <authors>OpenAI</authors>
    <owners>seacrackersinception</owners>
    <copyright>Copyright 2026 OpenAI</copyright>
    <packageSourceUrl>https://github.com/ewanrf/chocolatey-packages/tree/chatgpt-msix</packageSourceUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/ewanrf/chocolatey-packages@chatgpt-msix/icons/chatgpt-msix.png</iconUrl>
    <projectUrl>https://chatgpt.com/download/</projectUrl>
    <docsUrl>https://help.openai.com/en/articles/9982051-using-the-chatgpt-windows-app</docsUrl>
    <licenseUrl>https://openai.com/policies/terms-of-use/</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <tags>chatgpt openai ai assistant desktop msix</tags>
    <summary>OpenAI's ChatGPT desktop app for Windows.</summary>
    <description>ChatGPT Desktop provides ChatGPT, ChatGPT Work, and Codex in one Windows desktop app.

This package downloads OpenAI's current official x64 MSIX, verifies its Authenticode signature and publisher identity, then installs it for the current user. It requires Windows 10 version 2004 (build 19041) or later.

You must sign in with a ChatGPT account. Feature availability depends on your ChatGPT plan and workspace settings.</description>
    <releaseNotes>Uses OpenAI's current signed MSIX and compares its manifest version with the installed app before installation.</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
