<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>claude-desktop</id>
    <version>1.34493.1.2</version>
    <title>Claude Desktop</title>
    <owners>ewanrf</owners>
    <authors>Anthropic PBC</authors>
    <copyright>Anthropic PBC</copyright>
    <packageSourceUrl>https://github.com/ewanrf/chocolatey-packages</packageSourceUrl>
    <projectUrl>https://claude.com/download</projectUrl>
    <licenseUrl>https://www.anthropic.com/legal/consumer-terms</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <docsUrl>https://support.claude.com/en/articles/12622703-deploy-claude-desktop-for-windows</docsUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/ewanrf/chocolatey-packages@claude-desktop-1.34493.1.2/icons/claude.png</iconUrl>
    <tags>claude anthropic ai chat desktop windows</tags>
    <summary>Claude Desktop for Windows.</summary>
    <description>Claude Desktop is Anthropic's Windows application for Claude chat, Claude Code, and Claude Cowork.

This package downloads Anthropic's official signed x64 installer, validates its SHA-256 checksum, and installs it silently for the current user.</description>
    <releaseNotes>Uses the official signed x64 installer so Chocolatey can support the verifier environment. Packages Claude Desktop 1.34493.1.</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
