<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>claude-desktop</id>
    <version>1.34493.1</version>
    <title>Claude Desktop</title>
    <owners>ewanrf</owners>
    <authors>Anthropic PBC</authors>
    <copyright>Anthropic PBC</copyright>
    <packageSourceUrl>https://github.com/ewanrf/chocolatey-packages</packageSourceUrl>
    <projectUrl>https://claude.com/download</projectUrl>
    <licenseUrl>https://www.anthropic.com/legal/consumer-terms</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <docsUrl>https://support.claude.com/en/articles/12622703-deploy-claude-desktop-for-windows</docsUrl>
    <tags>claude anthropic ai chat desktop msix windows</tags>
    <summary>Claude Desktop for Windows.</summary>
    <description>Claude Desktop is Anthropic's Windows application for Claude chat, Claude Code, and Claude Cowork.

This package downloads Anthropic's official signed MSIX installer for the native x64 or ARM64 architecture, validates its SHA-256 checksum, and installs it for the current user. Windows 10 version 1903 or later is required.</description>
    <releaseNotes>Packages Claude Desktop 1.34493.1 for Windows x64 and ARM64.</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
